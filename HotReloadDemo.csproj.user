<Project>
	<PropertyGroup Condition="'$(UnoForceSingleTFM)'=='true'">
		<TargetFramework>net10.0-desktop</TargetFramework>
		<Configuration>Debug</Configuration>
	</PropertyGroup>
	<PropertyGroup>
		<UnoPlatformIDE>vscode</UnoPlatformIDE>
		<UnoPlatformIDEVersion>1.143.1</UnoPlatformIDEVersion>
		<UnoPlatformExtension>unoplatform.vscode 0.26.2</UnoPlatformExtension>
		<UnoRemoteControlPort>9327</UnoRemoteControlPort>
		<UnoVSCodeCSharpExtension>ms-dotnettools.csharp 2.160.4</UnoVSCodeCSharpExtension>
		<UnoVSCodeCSharpDevKitExtension>ms-dotnettools.csdevkit 3.40.215</UnoVSCodeCSharpDevKitExtension>
	</PropertyGroup>
	</Project>